{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "talera-r19-lifeline-i18n-preview-dev",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
