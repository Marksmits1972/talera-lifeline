{
 "name": "talera-free-10m-assets-isolated-NOT-DEPLOYED",
 "main": "./free-worker.mjs",
 "compatibility_date": "2026-09-18",
 "workers_dev": true,
 "assets": {
  "directory": "./public",
  "base_path": "/__talera_free",
  "binding": "ASSETS",
  "run_worker_first": ["/*","!/__talera_free/assets/*"]
 },
 "services": [
  {"binding":"TALERA_BASE","service":"talera-free-staging-backend-UNCREATED"}
 ],
 "d1_databases": [
  {
   "binding":"BIRTH_DB",
   "database_name":"talera-free-birthdate-staging-UNCREATED",
   "database_id":"00000000-0000-4000-8000-000000000000"
  }
 ]
}
