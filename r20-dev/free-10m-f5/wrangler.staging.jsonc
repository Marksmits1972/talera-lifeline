  "vars": {
    "AUTH_STORAGE_JURISDICTION": "eu",
    "SOCIAL_STORAGE_JURISDICTION": "eu",
    "F5_EASY_INVITE_SHA256": "34c8d1e77ec9d476189a098422d3fb68f2493e89b3af26a24e0607855707db8d",
    "F5_EASY_INVITE_EXPIRES": "1794859200000"
