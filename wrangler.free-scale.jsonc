// Isolated TALERA Free performance staging. Never deploy on the production name.
// Run: node scripts/build-free-scale.mjs && npx wrangler deploy --config wrangler.free-scale.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talera-free-10m-staging",
  "main": "src/free-scale-worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/free-scale-assets",
    "run_worker_first": false
  }
}